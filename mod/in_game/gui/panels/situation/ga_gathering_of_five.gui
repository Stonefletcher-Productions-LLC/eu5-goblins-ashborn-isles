situation_panel = {
    blockoverride "situation_subheader_content" {}
    blockoverride "situation_header_left" {
        visible = yes
        text_single = { text = "ga_gathering_header" fontsize = 13 }
    }
    blockoverride "situation_panel_main_content" {
        text_single = {
            layoutpolicy_horizontal = expanding
            text = "ac_favor_current"
            tooltip = "ac_favor_explanation"
        }
        text_multi = {
            layoutpolicy_horizontal = expanding
            max_width = 400
            autoresize = yes
            text = "ga_ui_homeland_progress"
        }
        text_multi = {
            layoutpolicy_horizontal = expanding
            max_width = 400
            autoresize = yes
            text = "ga_ui_homeland_rules"
        }
        text_multi = {
            layoutpolicy_horizontal = expanding
            max_width = 400
            autoresize = yes
            text = "ga_ui_compact_heading"
        }
        text_multi = {
            layoutpolicy_horizontal = expanding
            max_width = 400
            autoresize = yes
            text = "ga_ui_compact_route"
        }
        text_multi = {
            layoutpolicy_horizontal = expanding
            max_width = 400
            autoresize = yes
            text = "ga_ui_history_note"
        }
        situation_card_common = {
            blockoverride "common_header_icon" {}
            blockoverride "common_header_text" { text = "ga_gathering_race" }
            blockoverride "common_bottom_content" {
                text_multi = {
                    layoutpolicy_horizontal = expanding
                    max_width = 460
                    autoresize = yes
                    text = "ga_gathering_of_five_desc"
                }
            }
        }
        vbox = {
            layoutpolicy_horizontal = expanding
            spacing = 4
            text_single = { text = "ga_gathering_standings" fontsize = 13 }

            vbox = {
                datacontext = "[GetCountry('CDM')]"
                layoutpolicy_horizontal = expanding
                using = bg_paper_card
                using = bg_cabinet_card_frame
                margin = { 8 6 }
                spacing = 3
                hbox = {
                    layoutpolicy_horizontal = expanding
                    spacing = 8
                    country_flag_small = {
                        size = { 42 28 }
                        tooltipwidget = { using = CountryTooltip }
                    }
                    vbox = {
                        layoutpolicy_horizontal = expanding
                        text_single = {
                            layoutpolicy_horizontal = expanding
                            autoresize = yes
                            text = "[Country.GetName]"
                        }
                        text_single = {
                            visible = "[Country.Exists]"
                            layoutpolicy_horizontal = expanding
                            fontsize = 13
                            autoresize = yes
                            text = "[Country.GetGovernment.GetRulerOrRegent.GetName]"
                        }
                        text_single = {
                            visible = "[And(Country.Exists, EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('ga_pact_step_CDM'), '(CFixedPoint)0'))]"
                            layoutpolicy_horizontal = expanding
                            fontsize = 13
                            autoresize = yes
                            text = "ga_pact_step_strangers"
                            tooltip = "ga_pact_step_strangers_tt"
                        }
                        text_single = {
                            visible = "[And(Country.Exists, EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('ga_pact_step_CDM'), '(CFixedPoint)1'))]"
                            layoutpolicy_horizontal = expanding
                            fontsize = 13
                            autoresize = yes
                            text = "ga_pact_step_trusted"
                            tooltip = "ga_pact_step_trusted_tt"
                        }
                        text_single = {
                            visible = "[And(Country.Exists, EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('ga_pact_step_CDM'), '(CFixedPoint)2'))]"
                            layoutpolicy_horizontal = expanding
                            fontsize = 13
                            autoresize = yes
                            text = "ga_pact_step_sworn"
                            tooltip = "ga_pact_step_sworn_tt"
                        }
                        text_single = {
                            visible = "[And(Country.Exists, EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('ga_pact_step_CDM'), '(CFixedPoint)3'))]"
                            layoutpolicy_horizontal = expanding
                            fontsize = 13
                            autoresize = yes
                            text = "ga_pact_step_bound"
                            tooltip = "ga_pact_step_bound_tt"
                        }
                    }
                    text_single = {
                        visible = "[Not(Country.Exists)]"
                        text = "ga_gathering_annexed"
                        tooltip = "ga_gathering_annexed_tt"
                    }
                    text_single = {
                        visible = "[And(Country.Exists, EqualTo_CFixedPoint(Country.MakeScope.ScriptValue('ga_gathering_crown_status'), '(CFixedPoint)1'))]"
                        text = "ga_gathering_realm_count"
                        tooltip = "ga_gathering_progress_tt"
                    }
                    text_single = {
                        visible = "[And(Country.Exists, EqualTo_CFixedPoint(Country.MakeScope.ScriptValue('ga_gathering_crown_status'), '(CFixedPoint)2'))]"
                        text = "ga_gathering_vassal"
                        tooltip = "ga_gathering_dependent_tt"
                    }
                    text_single = {
                        visible = "[And(Country.Exists, EqualTo_CFixedPoint(Country.MakeScope.ScriptValue('ga_gathering_crown_status'), '(CFixedPoint)3'))]"
                        text = "ga_gathering_junior"
                        tooltip = "ga_gathering_dependent_tt"
                    }
                    text_single = {
                        visible = "[And(Country.Exists, EqualTo_CFixedPoint(Country.MakeScope.ScriptValue('ga_gathering_crown_status'), '(CFixedPoint)4'))]"
                        text = "ga_gathering_subject"
                        tooltip = "ga_gathering_other_subject_tt"
                    }
                }
                progressbar = {
                    visible = "[And(Country.Exists, EqualTo_CFixedPoint(Country.MakeScope.ScriptValue('ga_gathering_crown_status'), '(CFixedPoint)1'))]"
                    layoutpolicy_horizontal = expanding
                    size = { -1 8 }
                    min = 0
                    max = 109
                    value = "[FixedPointToFloat(Country.MakeScope.ScriptValue('ga_gathering_realm_locations'))]"
                    progresstexture = "gfx/interface/progressbars/progress_bar_yellow.dds"
                    noprogresstexture = "gfx/interface/icons/unit_view/moral_bar_transparent.dds"
                    tooltip = "ga_gathering_progress_tt"
                }
            }

